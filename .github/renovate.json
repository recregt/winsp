{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "fetchChangeLogs": "on",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "cargo",
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "Rust crates",
      "semanticCommitType": "chore",
      "semanticCommitScope": "cargo"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "github"
    },
    {
      "matchDepNames": ["evilmartians/lefthook"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "scripts"
    },
    {
      "matchDepNames": ["rhysd/actionlint"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "scripts"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/install-lefthook\\.py$/"],
      "matchStrings": [
        "VERSION = \"(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "evilmartians/lefthook",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/install-actionlint\\.py$/"],
      "matchStrings": [
        "VERSION = \"(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
