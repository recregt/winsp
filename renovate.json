{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "fetchChangeLogs": "off",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["rust"],
      "groupName": "Rust toolchain"
    },
    {
      "matchManagers": ["cargo"],
      "groupName": "Rust crates"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "Cargo CI tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)Dockerfile$",
        "\\.gitlab-ci\\.ya?ml$"
      ],
      "matchStrings": [
        "cargo binstall -y (?<depName>[\\w-]+) --version (?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "crate"
    }
  ]
}
